  "patterns": [
    {
      "id": "decorative-accent-rail",
      "defaultAction": "remove",
      "allowedContexts": [
        "error",
        "warning",
        "success",
        "selected-state",
        "progress",
        "comparison-diff"
      ],
      "proofRequired": "A text or icon cue conveys the same state without colour."
    },
    {
      "id": "nested-or-section-per-card",
      "defaultAction": "flatten",
      "allowedContexts": [
        "interactive-module",
        "bounded-result",
        "plan-comparison",
        "modal",
        "separately-actionable-object"
      ],
      "proofRequired": "The boundary changes interaction or comprehension, not decoration alone."
    },
    {
      "id": "gradient-or-glow-decoration",
      "defaultAction": "replace-with-solid-token-surface",
      "allowedContexts": [
        "data-visualization",
        "media-artwork",
        "single-brand-moment"
      ],
      "proofRequired": "Contrast, reduced-motion, and theme behavior pass."
    },
    {
      "id": "badge-or-pill-overuse",
      "defaultAction": "convert-to-plain-metadata",
      "allowedContexts": [
        "status",
        "tier",
        "availability",
        "confidence",
        "freshness",
        "category-state"
      ],
      "proofRequired": "The badge communicates a real state."
    },
    {
      "id": "uppercase-eyebrow-repetition",
      "defaultAction": "use-sentence-case-or-remove",
      "allowedContexts": [
        "short-code",
        "statutory-abbreviation",
        "operational-status"
      ],
      "proofRequired": "The uppercase form is conventional or materially improves scanning."
    },
    {
      "id": "generic-campaign-copy",
      "defaultAction": "rewrite-for-task-output-constraint-source-and-next-action",
      "allowedContexts": [
        "verified-registry-backed-public-claim"
      ],
      "proofRequired": "The claim is measurable and registered."
    },
    {
      "id": "decorative-emoji-flag-or-icon",
      "defaultAction": "remove-or-use-shared-svg",
      "allowedContexts": [
        "country-identity",
        "input-meaning",
        "state"
      ],
      "proofRequired": "Accessible text remains available."
    },
    {
      "id": "oversized-radius-or-heavy-shadow",
      "defaultAction": "return-to-design-tokens",
      "allowedContexts": [
        "modal",
        "dialog",
        "elevated-interactive-surface"
      ],
      "proofRequired": "Elevation represents real interaction layering."
    },
    {
      "id": "duplicate-trust-disclosure-panels",
      "defaultAction": "consolidate-without-content-loss",
      "allowedContexts": [
        "legally-distinct-disclosure",
        "materially-distinct-data-boundary"
      ],
      "proofRequired": "All required source, privacy, safety, and confidence information remains readable."
    },
    {
      "id": "fake-affordance",
      "defaultAction": "remove-or-hide-until-wired",
      "allowedContexts": [],
      "proofRequired": "Every visible control completes its advertised action."
    }
